@model WebApplication1.Models.Movie
@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<p>Жанр: @Model.Genre</p>
<p>Рік: @Model.Year</p>

<h3>Відгуки</h3>
@if (Model.Reviews.Any())
{
    <ul>
        @foreach (var r in Model.Reviews)
        {
            <li>@r.Author (@r.Rating/10): @r.Text</li>
        }
    </ul>
}
else
{
    <p>Відгуків поки немає</p>
}

<a asp-action="Index">Назад до списку</a> | <a asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a> | <a asp-action="Delete" asp-route-id="@Model.Id">Видалити</a>
