@model List<WebApplication1.Models.Movie>
@{
    ViewData["Title"] = "Фільми";
}

<h1>Фільми</h1>

<p><a asp-action="Create">Додати фільм</a></p>

<ul>
    @foreach (var m in Model)
    {
        <li><a asp-action="Details" asp-route-id="@m.Id">@m.Title</a> (@m.Year) <a asp-action="Edit" asp-route-id="@m.Id">Редагувати</a> <a asp-action="Delete" asp-route-id="@m.Id">Видалити</a></li>
    }
</ul>

@if (!Model.Any())
{
    <p>Фільмів поки немає</p>
}
