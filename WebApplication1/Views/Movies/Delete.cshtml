@model WebApplication1.Models.Movie
@{
    ViewData["Title"] = "Видалити";
}

<h1>Видалити фільм?</h1>
<p>Назва: @Model.Title</p>
<p>Жанр: @Model.Genre</p>
<p>Рік: @Model.Year</p>

<form method="post" asp-action="Delete" asp-route-id="@Model.Id">
    <input type="submit" value="Видалити" />
    <a asp-action="Index">Скасувати</a>
</form>
