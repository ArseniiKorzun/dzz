@model WebApplication1.Models.Movie
@{
    ViewData["Title"] = "Редагувати фільм";
}

<h1>Редагувати фільм</h1>

<form method="post" asp-action="Edit">
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="Id" />
    <p>
        <label asp-for="Title">Назва</label><br />
        <input asp-for="Title" required />
        <span asp-validation-for="Title"></span>
    </p>
    <p>
        <label asp-for="Genre">Жанр</label><br />
        <input asp-for="Genre" required />
        <span asp-validation-for="Genre"></span>
    </p>
    <p>
        <label asp-for="Year">Рік</label><br />
        <input asp-for="Year" required />
        <span asp-validation-for="Year"></span>
    </p>
    <input type="submit" value="Зберегти" />
    <a asp-action="Index">Скасувати</a>
</form>
