@model List<WebApplication1.Models.Product>
@{
    ViewData["Title"] = "Пошук товарів";
    var query = ViewData["Query"] as string;
}

<h1>Пошук товарів</h1>

<form method="get" asp-action="Search">
    <input type="text" name="name" value="@query" placeholder="Назва товару" />
    <input type="submit" value="Пошук" />
</form>

@if (string.IsNullOrWhiteSpace(query))
{
    <p>Введіть назву для пошуку</p>
}
else if (!Model.Any())
{
    <p>За запитом «@query» нічого не знайдено</p>
}
else
{
    <ul>
        @foreach (var p in Model)
        {
            <li><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a> — @p.Price.ToString("0.00") грн</li>
        }
    </ul>
}

<a asp-action="Index">До каталогу</a>
