@model List<WebApplication1.Models.Product>
@{
    ViewData["Title"] = "Каталог товарів";
}

<h1>Каталог товарів</h1>

<form method="get" asp-action="Search">
    <input type="text" name="name" placeholder="Назва товару" />
    <input type="submit" value="Пошук" />
</form>

<p><a asp-action="Create">Додати товар</a></p>

<ul>
    @foreach (var p in Model)
    {
        <li><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a> — @p.Price.ToString("0.00") грн</li>
    }
</ul>

@if (!Model.Any())
{
    <p>Товарів поки немає</p>
}
